@page
@model Post
@{
    ViewData["Title"] = "Create a Post";
}

<div class="text-center">
    <h1 class="display-4">Create a New Post</h1>
</div>

<form action="Create/CreatePost" method="post">

	<div>
		<label asp-for="Title"></label>
		<br />
		<input asp-for="Title" class="form-element" style="font-size:16pt;" />
	</div>

	<div>
		<label asp-for="Body" style="margin-top:15px;"></label>
		<br />
		<textarea asp-for="Body" class="form-element"></textarea>
	</div>

	<button type="submit" style="margin-top:15px;">Post</button>
</form>

