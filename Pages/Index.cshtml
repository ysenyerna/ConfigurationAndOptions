@page
@using Microsoft.Extensions.Options
@model IndexModel
@inject IOptions<SiteOptions> Options;
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">@Options.Value.SiteName - Home</h1>
</div>

@{

	// Iterate through all posts backwards and add them
	for (int i = Model.PostData.Count - 1; i >= 0; i--)
	{
		ViewData["id"] = i;
		<partial name="_PostCard" view-data="ViewData"></partial>

	}
}